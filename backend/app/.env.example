PORT=5000
NODE_ENV=development

# Database configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=siapt
DB_USER=siapt
DB_PASSWORD=change-this-password

# Autentikasi sementara (shim di src/middleware/auth.js) selama modul auth Clara belum masuk staging.
# true  = identitas dibaca dari header x-pengenal. HANYA untuk uji lokal di laptop.
# false = semua route yang dilindungi menolak dengan 401. Wajib false di staging/production.
AUTH_SEMENTARA=false
